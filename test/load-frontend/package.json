{
    "name": "load-test-frontend",
    "version": "1.0.0",
    "description": "Load and Performance Tests using k6",
    "scripts": {
        "test:local": "docker compose run --rm k6-local",
        "test:local:light": "npm run test:local -- -e VUS=10 -e DURATION=30s",
        "test:local:medium": "npm run test:local -- -e VUS=50 -e DURATION=1m",
        "test:local:heavy": "npm run test:local -- -e VUS=200 -e DURATION=3m"
    },
    "devDependencies": {
        "@types/k6": "^0.45.0",
        "prettier": "^3.8.3",
        "typescript": "^5.2.2"
    }
}
