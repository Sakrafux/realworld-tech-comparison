---
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import NavBar from "@/components/NavBar.tsx";

const { pathname } = Astro.url;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- Icons: the ion-* classes used in the templates below (legacy Ionicons v2) -->
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/ionicons/2.0.1/css/ionicons.min.css"
        />
        <!-- Fonts the theme uses -->
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700|Lora:400,700"
        />

        <link rel="stylesheet" href="/index.css" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <meta name="generator" content={Astro.generator} />
        <title>Conduit</title>

        <ClientRouter />
    </head>
    <body>
        <NavBar client:load initialPath={pathname} transition:persist />
        <slot />
        <Footer />
    </body>
</html>
