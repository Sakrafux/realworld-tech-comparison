---
import HomeArticles from "@/components/HomeArticles";
import Tags from "@/components/Tags";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
    <div class="home-page">
        <div class="banner">
            <div class="container">
                <h1 class="logo-font">conduit</h1>
                <p>A place to share your knowledge.</p>
            </div>
        </div>

        <div class="container page">
            <div class="row">
                <div class="col-md-9">
                    <div class="feed-toggle">
                        <ul class="nav nav-pills outline-active">
                            <li class="nav-item">
                                <a id="link-your-feed" class="nav-link" href="/?feed=following"
                                    >Your Feed</a
                                >
                            </li>
                            <li class="nav-item">
                                <a id="link-global-feed" class="nav-link" href="/">Global Feed</a>
                            </li>
                        </ul>
                    </div>

                    <HomeArticles client:only="preact" />
                </div>

                <div class="col-md-3">
                    <div class="sidebar">
                        <p>Popular Tags</p>

                        <Tags client:load />
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    function handleSearchParams() {
        const isFollowing = new URLSearchParams(window.location.search).has("feed", "following");
        if (isFollowing) {
            document.getElementById("link-your-feed")?.classList.add("active");
            document.getElementById("link-global-feed")?.classList.remove("active");
        } else {
            document.getElementById("link-your-feed")?.classList.remove("active");
            document.getElementById("link-global-feed")?.classList.add("active");
        }
    }

    // Runs on initial load AND after every transition/redirect
    document.addEventListener("astro:page-load", handleSearchParams);
</script>
