---
import HomeArticles from "@/components/HomeArticles";
import Tags from "@/components/Tags";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = false;
const { tag } = Astro.params;
---

<BaseLayout>
    <div class="home-page">
        <div class="banner">
            <div class="container">
                <h1 class="logo-font">conduit</h1>
                <p>A place to share your knowledge.</p>
            </div>
        </div>

        <div class="container page">
            <div class="row">
                <div class="col-md-9">
                    <div class="feed-toggle">
                        <ul class="nav nav-pills outline-active">
                            <li class="nav-item">
                                <a class="nav-link" href="/?feed=following">Your Feed</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/">Global Feed</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active" href={`/tag/${tag}`}>#{tag}</a>
                            </li>
                        </ul>
                    </div>

                    <HomeArticles client:only="preact" tag={tag} />
                </div>

                <div class="col-md-3">
                    <div class="sidebar">
                        <p>Popular Tags</p>

                        <Tags client:only="preact" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
