# Stage 1: Install dependencies and build the application
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm build

# Stage 3: Production environment
FROM node:22-alpine AS runtime
WORKDIR /app

# Astro SSR requires production dependencies and the build outputs
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./package.json

# Environment variables to bind to the Docker network container correctly
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NODE_ENV=production
ENV BASE_URL=http://backend:8080/api

EXPOSE 3000

# Execute the standalone server entrypoint generated by Astro
CMD ["node", "./dist/server/entry.mjs"]